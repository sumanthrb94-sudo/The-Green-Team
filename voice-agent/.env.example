# Copy to .env — .env is gitignored. Never commit real values.
# In production these come from Secret Manager, not a file.

# --- Sarvam (speech + LLM) --------------------------------------------------
SARVAM_API_KEY=""
SARVAM_TTS_MODEL="bulbul:v3"
# The cloned voice id from the Sarvam console. Until the voice actor is
# recorded, leave the stock speaker so the pipeline still runs.
SARVAM_VOICE_ID="anushka"
# Leave STT model unset to take Sarvam's current default.
SARVAM_STT_MODEL=""
SARVAM_STT_MODE="codemix"
SARVAM_LLM_BASE_URL="https://api.sarvam.ai/v1"
SARVAM_LLM_MODEL="sarvam-30b"

# --- LLM choice -------------------------------------------------------------
# "sarvam" (default, ₹0.03/call-min) or "gemini" (₹0.15) for the week-1 bench.
LLM_PROVIDER="sarvam"
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# --- Agent ------------------------------------------------------------------
AGENT_PROJECT="agartha"          # agartha | syl
AGENT_LANGUAGE="te-IN"
TTS_PACE="1.0"
TTS_MIN_BUFFER="50"

# --- Web channel (ships first — no DLT, no telecom licence) -----------------
# Origins allowed to embed the widget. Never use "*" — that lets any site
# mount your agent and spend your Sarvam credits.
ALLOWED_ORIGINS="http://localhost:3000,https://thegreenteam.in"
MAX_WEB_SESSIONS="20"

# TG-RERA agent registration number. Leave empty until it comes through — the
# agent is instructed to defer rather than state a number it doesn't have.
RERA_AGENT_REG_NO=""

# --- Telephony (blocked until DLT registration clears) ----------------------
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_FROM_NUMBER=""             # must be a DLT-registered 140-series number
PUBLIC_HOST=""                   # Cloud Run hostname, no scheme

# --- GCP --------------------------------------------------------------------
# Cloud Run supplies credentials via the attached service account (ADC).
# Do NOT set GOOGLE_APPLICATION_CREDENTIALS or mount a service-account JSON.
GOOGLE_CLOUD_PROJECT="thegreenteam-17cfc"

# --- Compliance -------------------------------------------------------------
CALL_WINDOW_START="9"
CALL_WINDOW_END="21"
