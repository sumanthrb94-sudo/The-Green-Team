# Firebase / Firestore — copy values from your Firebase project settings
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Telugu voice agent — origin of the running agent service (voice-agent/).
# Leave empty and the call button simply doesn't render.
#   local  http://localhost:8080
#   prod   https://voice-agent-xxxx.a.run.app
VITE_AGENT_HOST=""

# TG-RERA agent registration number, once it comes through. Shown in the
# voice widget's consent panel. Leave empty until you actually hold it.
VITE_RERA_AGENT_REG_NO=""
