# Firebase / Firestore — copy values from your Firebase project settings
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ── Analytics & measurement ──────────────────────────────────────────────
# GA4 measurement ID. Without it, every trackEvent() call is a silent no-op —
# which is the correct behaviour locally and on preview builds.
# NOTE: this is NOT the same as NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID. That one
# exists in the Firebase config but nothing ever initialised it, so it never
# sent a single event.
NEXT_PUBLIC_GA_ID=""

# Microsoft Clarity project ID — heatmaps and session recordings. Free.
# clarity.microsoft.com → create project → copy the ID from the tracking code.
NEXT_PUBLIC_CLARITY_ID=""

# Google Search Console, HTML-tag verification method only. Leave empty if the
# property is verified by DNS instead.
NEXT_PUBLIC_GSC_VERIFICATION=""

# Salt for the first-party analytics visitor hash. The IP is never stored — it
# is reduced to a salted SHA-256 whose salt rotates daily. There is a built-in
# default so nothing breaks without this, but it is a public placeholder: set a
# private random string in Vercel so the hashes cannot be reproduced.
ANALYTICS_SALT=""

# Resend — transactional + newsletter email. Create the key at resend.com → API
# Keys (sending access is enough). The two segment IDs group contacts for
# broadcasts: everyone who ticks the newsletter box, and everyone who signs in.
# All three are required in Vercel for contact sync and newsletter dispatch.
RESEND_API_KEY=""
RESEND_SEGMENT_NEWSLETTER=""
RESEND_SEGMENT_MEMBERS=""
