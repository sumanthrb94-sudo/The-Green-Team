# Demo-mode env — consumed only by `npm run dev:demo` (vite --mode demo).
# These are NOT credentials. src/lib/firebase.ts disables itself when
# VITE_FIREBASE_API_KEY is empty, so demo mode supplies placeholders while the
# firebase/* imports are aliased to the in-memory stand-ins in scripts/demo-firebase/.
VITE_FIREBASE_API_KEY="demo-mode-not-a-real-key"
VITE_FIREBASE_AUTH_DOMAIN="demo.local"
VITE_FIREBASE_PROJECT_ID="demo-green-team"
VITE_FIREBASE_STORAGE_BUCKET="demo-green-team.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:demo"
