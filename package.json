{
  "name": "the-green-team",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "kb:index": "tsx --conditions=react-server --env-file=.env.local scripts/build-kb-index.ts",
    "e2e:chat": "node --env-file=.env.local scripts/e2e-chat.mjs",
    "kb:eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval-retrieval.ts",
    "analytics:prune": "tsx --env-file=.env.local scripts/prune-analytics.ts",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:write": "node scripts/optimize-images.mjs --write",
    "speed": "node scripts/speed-test.mjs",
    "email": "email dev --dir emails --port 3030"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "react-email": "^6.9.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2"
  }
}
